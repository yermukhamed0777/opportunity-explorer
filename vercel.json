{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci --ignore-scripts --no-fund --no-audit",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    },
    "api/document.js": {
      "maxDuration": 60,
      "includeFiles": "lib/**"
    }
  },
  "crons": [
    {
      "path": "/api/refresh",
      "schedule": "0 1 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/login",
      "destination": "/auth.html"
    },
    {
      "source": "/reset-password",
      "destination": "/auth.html"
    },
    {
      "source": "/auth/update-password",
      "destination": "/auth.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/auth.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/search",
      "destination": "/index.html"
    },
    {
      "source": "/admissions",
      "destination": "/index.html"
    },
    {
      "source": "/professional-pathways",
      "destination": "/index.html"
    },
    {
      "source": "/research",
      "destination": "/index.html"
    },
    {
      "source": "/funding",
      "destination": "/index.html"
    },
    {
      "source": "/my-plan",
      "destination": "/index.html"
    },
    {
      "source": "/system-health",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/auth/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/reset-password",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
