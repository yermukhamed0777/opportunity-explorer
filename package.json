{
  "name": "opportunity-explorer",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "build": "node scripts/build-catalog.cjs",
    "test": "node tests/check.cjs && node --test tests/*.test.js",
