  },
  "description": "Find, compare and track research programs, competitions and scholarships.",
  "author": "Yermukhamed Tuktibay",
  "devDependencies": {
    "prettier": "3.9.10"
  },
  "overrides": {
    "zod": "4.6.6"
  }
}
