# Copy this file to .env.local for npm run dev (Node 24 loads it automatically).
# Required public account settings: use the same Supabase project for both.
# Only these two values are returned to the browser. Never use a secret/service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional server-only capabilities. Leave unused secrets blank.
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
AI_GATEWAY_MODEL=openai/gpt-4.1-nano
# Local AI needs this key; Vercel deployments may instead use injected VERCEL_OIDC_TOKEN.
# Do not copy deployment OIDC tokens into this file or browser configuration.
AI_GATEWAY_API_KEY=

# Server only; optional until account deletion is enabled. Never use a NEXT_PUBLIC name.
SUPABASE_SECRET_KEY=
